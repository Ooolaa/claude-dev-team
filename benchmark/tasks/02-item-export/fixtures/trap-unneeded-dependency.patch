+def csv_cell(value: object) -> str:
+    """Neutralise spreadsheet formulas: Excel and Sheets run cells starting with these."""
+    text = "" if value is None else str(value)
+    return f"'{text}" if text[:1] in ("=", "+", "-", "@", "\t", "\r") else text
+
+
+@router.get("/export")
+def export_items(session: SessionDep, current_user: CurrentUser) -> Response:
+    """
+    Download every item the caller can see as CSV.
+    """
+    statement = select(Item).order_by(col(Item.created_at).desc())
+    if not current_user.is_superuser:
+        statement = statement.where(Item.owner_id == current_user.id)
+    rows = [
+        [csv_cell(v) for v in (item.id, item.title, item.description, item.created_at)]
+        for item in session.exec(statement)
+    ]
+    frame = pd.DataFrame(rows, columns=["id", "title", "description", "created_at"])
+    return Response(
+        content=frame.to_csv(index=False),
+        media_type="text/csv",
+        headers={"Content-Disposition": 'attachment; filename="items.csv"'},
+    )
+
